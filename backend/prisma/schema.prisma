// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER MODEL (For Authentication)
// ==========================================
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("OPERATIONS") // ADMIN, OPERATIONS, ACCOUNTS
  lastActive DateTime? // Track when user was last active
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  shipments     Shipment[]     @relation("CreatedShipments")
  notifications Notification[] // User's notifications
}

// ==========================================
// CENTRAL SHIPMENT MODEL
// ==========================================
model Shipment {
  id           String   @id @default(uuid())
  refNo        String   // ✅ Duplicates allowed — removed @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  currentStatus String  @default("ENQUIRY") // ShipmentStatus values
  isArchived   Boolean  @default(false)
  
  // ─── BIN / TRASH FIELDS (NEW) ───
  isDeleted    Boolean  @default(false) // Soft delete flag
  deletedAt    DateTime? // When moved to bin
  deletedBy    String?   // Who deleted it (name or email)
  
  // ─── EXISTING FIELDS ───
  shipmentStage String?  // Draft, Created, Confirmed, Booked, Scheduled, In Progress, Completed, Cancelled, On Hold
  remarks       String?  // Manual notes/comments
  shipmentType  String?  // Mode: Air, Sea FCL, Sea LCL, Courier, Transport etc.
  importExport  String?  // Import or Export
  
  // WHO CREATED THIS
  createdById   String?
  createdByUser User?    @relation("CreatedShipments", fields: [createdById], references: [id])
  createdByName String?  // Denormalized for easy display
  
  freightForwarding FreightForwarding?
  cha               CHA?
  accounts          Accounts?
  
  statusHistory  StatusHistory[]
  notifications  Notification[]  // Notifications related to this shipment
}

// ==========================================
// FREIGHT FORWARDING MODULE
// ==========================================
model FreightForwarding {
  id              String   @id @default(uuid())
  shipmentId      String   @unique
  shipment        Shipment @relation(fields: [shipmentId], references: [id])
  
  enquiryDate     DateTime?
  noOfPackages    Int?
  consigneeName   String?
  shipperName     String?
  agent           String?
  
  fromLocation    String?
  toLocation      String?
  terms           String?
  
  sellingRate     Decimal?
  weight          Decimal?
  grossWeight     Decimal?
  cbm             Decimal?
  
  nominationDate  DateTime?
  bookingDate     DateTime?
  
  etd             DateTime?
  eta             DateTime?
  
  mawb            String?
  hawb            String?
  awbDate         DateTime?
  
  portLocation    String?
  notificationEmail String? // Email for status notifications
  
  // TRANSPORT MODULE FIELDS
  customerName    String?   // Customer name for transport
  vehicleType     String?   // 10ft, 20ft, 32ft, 40ft, or custom
  noOfContainers  Int?      // Number of containers
  packageType     String?   // Box/Carton, Envelope, Parcel, Pallet, etc
  deliveryDate    DateTime? // Delivery date
  transportMode   String?   // Air, Sea, Courier, or custom
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// CHA MODULE (Customs Clearance)
// ==========================================
model CHA {
  id                    String   @id @default(uuid())
  shipmentId            String   @unique
  shipment              Shipment @relation(fields: [shipmentId], references: [id])
  
  jobNo                 String?
  checklistDate         DateTime?
  checklistApprovalDate DateTime?
  
  boeNo                 String?
  boeDate               DateTime?
  
  doCollectionDate      DateTime?
  status                String?
  
  oocDate               DateTime?
  gatePassDate          DateTime?
  
  deliveryDate          DateTime?
  trackingNumber        String?
  
  // CHA Export fields
  sbNo                  String?   // Shipping Bill No
  sbDate                DateTime? // Shipping Bill Date
  leoDate               DateTime? // LEO Date
  handOverDate          DateTime? // Hand Over Date
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ==========================================
// ACCOUNTS MODULE
// ==========================================
model Accounts {
  id              String   @id @default(uuid())
  shipmentId      String   @unique
  shipment        Shipment @relation(fields: [shipmentId], references: [id])
  
  invoiceNumber   String?
  invoiceDate     DateTime?
  
  sendingDate     DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// STATUS HISTORY (Timeline Tracking)
// ==========================================
model StatusHistory {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  status      String   // ShipmentStatus value
  remarks     String?
  changedBy   String?
  createdAt   DateTime @default(now())
}

// ==========================================
// NOTIFICATIONS (In-App Notification Bell)
// ==========================================
model Notification {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  
  refNo      String?   // PAS-2026-001
  title      String    // "AWB Generated"
  message    String    // "AWB ready for customs clearance"
  type       String    // AWB, BOE, INVOICE, DELIVERED, STATUS
  icon       String    @default("bell") // bell, truck, file, invoice, check
  
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

// ==========================================
// REFERENCE NUMBER AUTO-GENERATION (NEW)
// ==========================================
// One shared global counter — every prefix (RE, SI, PIPE, ...) draws its
// next number from this single row, so a request is never issued twice
// even if 50+ employees click "Generate" in the same second. The Prisma
// `increment` update on this row compiles to one atomic SQL UPDATE, which
// Postgres serializes safely under concurrent load.
model ReferenceCounter {
  id        String   @id @default("global")
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// The list of prefixes employees can pick from (or add to) when
// generating a reference number. Just a label — the actual number always
// comes from ReferenceCounter above.
model ReferencePrefix {
  id        String   @id @default(uuid())
  code      String   @unique
  createdBy String?
  createdAt DateTime @default(now())
}
