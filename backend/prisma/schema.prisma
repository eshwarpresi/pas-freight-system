// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER MODEL (For Authentication)
// ==========================================
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("OPERATIONS") // ADMIN, OPERATIONS, ACCOUNTS
  // ✅ TEAM (NEW) — which of the 3 shipment-workflow teams this employee
  // belongs to: FREIGHT, CUSTOMS, ACCOUNTS. Separate from `role` above
  // (which governs login permissions) since OPERATIONS covers both the
  // Freight and Customs teams today, and we need to tell those two apart
  // for the Team Performance report. Null = not yet assigned (e.g. Admins).
  team      String?
  lastActive DateTime? // Track when user was last active
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  shipments     Shipment[]     @relation("CreatedShipments")
  notifications Notification[] // User's notifications

  @@index([team]) // ✅ NEW — Team Performance's team-filter tabs
}

// ==========================================
// CENTRAL SHIPMENT MODEL
// ==========================================
model Shipment {
  id           String   @id @default(uuid())
  refNo        String   // ✅ Duplicates allowed — removed @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  currentStatus String  @default("ENQUIRY") // ShipmentStatus values
  isArchived   Boolean  @default(false)
  
  // ─── BIN / TRASH FIELDS (NEW) ───
  isDeleted    Boolean  @default(false) // Soft delete flag
  deletedAt    DateTime? // When moved to bin
  deletedBy    String?   // Who deleted it (name or email)
  
  // ─── EXISTING FIELDS ───
  shipmentStage String?  // Draft, Created, Confirmed, Booked, Scheduled, In Progress, Completed, Cancelled, On Hold
  remarks       String?  // Manual notes/comments
  shipmentType  String?  // Mode: Air, Sea FCL, Sea LCL, Courier, Transport etc.
  importExport  String?  // Import or Export
  
  // WHO CREATED THIS
  createdById   String?
  createdByUser User?    @relation("CreatedShipments", fields: [createdById], references: [id])
  createdByName String?  // Denormalized for easy display

  // ─── CO-HANDLER (NEW) ───
  // An optional second employee who should also see this shipment in
  // their own "My Shipments" — e.g. when one employee generates a
  // reference number using another employee's initials because they're
  // working on it together. Not a Prisma relation on purpose (mirrors
  // createdByName's denormalized-string pattern) — keeps this additive
  // and low-risk against the existing createdById/createdByUser relation.
  coHandlerId   String?
  coHandlerName String?

  // ─── TEAM HANDLED-BY BADGES (NEW) ───
  // Auto-stamped the first time anyone on that team acts on this
  // shipment (Customs: checklist/BOE/SB/OOC/gate pass/delivery; Accounts:
  // invoice generated/sent). Denormalized id+name pair, same pattern as
  // createdById/createdByName, so these can back both the visible
  // "Handled By" badges on the shipment and accurate per-employee
  // aggregation in the Team Performance report (matching by id, not
  // just name). Left null until that team actually touches the shipment
  // — a blank badge is the visual signal that nobody has yet.
  customsHandledById   String?
  customsHandledByName String?
  accountsHandledById   String?
  accountsHandledByName String?

  // ✅ FREIGHT COMPLETION STAMP (NEW) — unlike Customs/Accounts, the
  // Freight "creator" name was showing on the badge the instant a
  // shipment was opened, even with nothing filled in yet. This makes
  // Freight consistent with the other two teams: only stamped once
  // Consignee + Shipper + at least one of Weight/Gross Weight/Selling
  // Rate are all present (see checkAndStampFreightComplete in the
  // controller). Until then, the Freight badge shows blank, same as an
  // untouched Customs/Accounts badge.
  freightCompletedById   String?
  freightCompletedByName String?
  
  freightForwarding FreightForwarding?
  cha               CHA?
  accounts          Accounts?
  
  statusHistory  StatusHistory[]
  notifications  Notification[]  // Notifications related to this shipment

  // ✅ INDEXES (NEW) — without these, every filter/search on this table
  // forces Postgres to scan every single row. At a few hundred shipments
  // that's invisible; at 200,000+ it's the difference between an
  // instant response and a multi-second wait on every click. Each index
  // here targets a field this app actually filters, sorts, or searches
  // by somewhere in freightForwarding.controller.js.
  @@index([isDeleted, isArchived, createdAt]) // the single most common filter combo — getAllShipments' default view
  @@index([refNo]) // reference-code lookups, prefix searches
  @@index([currentStatus]) // status filter buttons, In Progress/Delivered/Invoiced cards
  @@index([createdById]) // "My Shipments", per-employee reports
  @@index([coHandlerId]) // co-handler "My Shipments" inclusion
  @@index([shipmentType]) // module dashboards (Freight/CHA/Transport/etc)
  @@index([isDeleted, createdAt]) // Today's/This Month's Shipments cards
  @@index([createdByName]) // search-by-employee-name, Team Performance matching
}

// ==========================================
// FREIGHT FORWARDING MODULE
// ==========================================
model FreightForwarding {
  id              String   @id @default(uuid())
  shipmentId      String   @unique
  shipment        Shipment @relation(fields: [shipmentId], references: [id])
  
  enquiryDate     DateTime?
  noOfPackages    Int?
  consigneeName   String?
  shipperName     String?
  agent           String?
  
  fromLocation    String?
  toLocation      String?
  terms           String?
  
  sellingRate     Decimal?
  weight          Decimal?
  grossWeight     Decimal?
  cbm             Decimal?
  
  nominationDate  DateTime?
  bookingDate     DateTime?
  
  etd             DateTime?
  eta             DateTime?
  
  mawb            String?
  hawb            String?
  awbDate         DateTime?
  
  portLocation    String?
  notificationEmail String? // Email for status notifications
  
  // TRANSPORT MODULE FIELDS
  customerName    String?   // Customer name for transport
  vehicleType     String?   // 10ft, 20ft, 32ft, 40ft, or custom
  noOfContainers  Int?      // Number of containers (Transport module)
  containerType   String?   // e.g. 1x20GP, 1x40HQ, etc. (Freight/FF Only)
  commodityName   String?   // ✅ NEW — Freight module only (standard Import/Export shipments)
  preAlertsSentDate DateTime? // ✅ NEW — Freight module only (standard Import/Export shipments)
  packageType     String?   // Box/Carton, Envelope, Parcel, Pallet, etc
  deliveryDate    DateTime? // Delivery date
  transportMode   String?   // Air, Sea, Courier, or custom
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ✅ INDEXES (NEW) — these back the search filter (contains, case-
  // insensitive) across consignee/shipper/HAWB/MAWB/customer name. A
  // plain btree index still helps Postgres a lot with prefix/equality
  // lookups even though substring "contains" search can't use it quite
  // as effectively as a full-text/trigram index would — see the note in
  // freightForwarding.controller.js about pg_trgm for a further upgrade
  // if search still feels slow at very large scale.
  @@index([consigneeName])
  @@index([shipperName])
  @@index([hawb])
  @@index([mawb])
  @@index([customerName])
}

// ==========================================
// CHA MODULE (Customs Clearance)
// ==========================================
model CHA {
  id                    String   @id @default(uuid())
  shipmentId            String   @unique
  shipment              Shipment @relation(fields: [shipmentId], references: [id])
  
  jobNo                 String?
  checklistDate         DateTime?
  checklistApprovalDate DateTime?
  
  boeNo                 String?
  boeDate               DateTime?
  
  doCollectionDate      DateTime?
  status                String?
  
  oocDate               DateTime?
  gatePassDate          DateTime?
  
  deliveryDate          DateTime?
  trackingNumber        String?
  
  // CHA Export fields
  sbNo                  String?   // Shipping Bill No
  sbDate                DateTime? // Shipping Bill Date
  leoDate               DateTime? // LEO Date
  handOverDate          DateTime? // Hand Over Date
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // ✅ INDEXES (NEW) — backs search-by-BOE/SB, and the autoArchiveMatured
  // / isArchiveEligible checks that filter on these being present.
  @@index([boeNo])
  @@index([sbNo])
}

// ==========================================
// ACCOUNTS MODULE
// ==========================================
model Accounts {
  id              String   @id @default(uuid())
  shipmentId      String   @unique
  shipment        Shipment @relation(fields: [shipmentId], references: [id])
  
  invoiceNumber   String?
  invoiceDate     DateTime?
  
  sendingDate     DateTime?

  // ✅ COMPLETED-AT (NEW) — stamped once, the first time Invoice No +
  // Invoice Date + Sending Date are all present. This is the anchor date
  // for the 30-day delayed auto-archive: a shipment only moves to Archive
  // once (now - completedAt) >= 30 days, instead of archiving the instant
  // the invoice is complete. Never overwritten after it's first set.
  completedAt     DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ✅ INDEXES (NEW) — invoiceNumber for search; completedAt for the
  // 30-day auto-archive sweep's date-range lookup, which would otherwise
  // scan every Accounts row to find matured invoices.
  @@index([invoiceNumber])
  @@index([completedAt])
}

// ==========================================
// STATUS HISTORY (Timeline Tracking)
// ==========================================
model StatusHistory {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  status      String   // ShipmentStatus value
  remarks     String?
  changedBy   String?
  createdAt   DateTime @default(now())

  // ✅ INDEXES (NEW) — this table takes the heaviest load of any table in
  // the app: Team Performance, Monthly Report, Daily Report, the
  // "Everyone Involved" contributor lookup, and the Handled-By badge
  // grouping all query it repeatedly, usually filtered by shipmentId,
  // status, changedBy, or a createdAt date range (often several of
  // these together). At 200,000+ shipments with multiple history rows
  // each, this table can easily be the single largest one in the
  // database — these indexes matter most here.
  @@index([shipmentId])
  @@index([status, createdAt])
  @@index([changedBy, createdAt])
  @@index([createdAt])
}

// ==========================================
// NOTIFICATIONS (In-App Notification Bell)
// ==========================================
model Notification {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  
  refNo      String?   // PAS-2026-001
  title      String    // "AWB Generated"
  message    String    // "AWB ready for customs clearance"
  type       String    // AWB, BOE, INVOICE, DELIVERED, STATUS
  icon       String    @default("bell") // bell, truck, file, invoice, check
  
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

// ==========================================
// REFERENCE NUMBER AUTO-GENERATION (NEW)
// ==========================================
// ⚠️ ReferenceCounter (below) is the OLD shared global counter — every
// prefix drew from this one row, so one prefix's numbers would jump
// unpredictably whenever ANY other prefix generated a number in
// between. No longer used by generateReferenceNumber; left in place
// only so nothing breaks if some old code path still references it.
model ReferenceCounter {
  id        String   @id @default("global")
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ReferencePrefix {
  id        String   @id @default(uuid())
  code      String   @unique
  createdBy String?
  createdAt DateTime @default(now())

  // ✅ PER-PREFIX COUNTER (NEW) — each prefix now has its OWN sequential
  // counter, so RLI always goes ...0319 -> 0320 -> 0321 regardless of
  // what PPI, SPI, JD, etc. are doing. Starts at 0; the first generation
  // under this new system auto-detects the highest number already used
  // by this prefix (scanning existing shipments) and continues from
  // there, so nothing resets or collides with numbers already issued
  // under the old shared-counter system.
  lastNumber Int @default(0)
}

model ReferenceInitial {
  id        String   @id @default(uuid())
  code      String   @unique
  createdBy String?
  createdAt DateTime @default(now())
}

// ✅ NEW — managed master list for Consignee and Shipper names, same
// pattern as ReferencePrefix/ReferenceInitial above: a real list the
// company maintains (add/rename/delete), not something auto-guessed from
// past shipments. One shared table for both, distinguished by `type`, so
// the same dropdown component works for either field.
model PartyName {
  id        String   @id @default(uuid())
  type      String   // 'CONSIGNEE' | 'SHIPPER'
  name      String
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([type, name])
  @@index([type])
}
